# ---------- Infra
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://air:air@localhost:5432/air
REDIS_URL=redis://127.0.0.1:6379
QUEUE_PREFIX=air

# ---------- Meta / WhatsApp Business Platform (Cloud API)
# App secret do app na Meta (valida X-Hub-Signature-256)
WHATSAPP_APP_SECRET=
# Token que você escolhe e informa no painel da Meta ao cadastrar o webhook (mín. 16 caracteres)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v25.0
# O token de acesso de cada número fica cifrado no banco (whatsapp_numbers), não aqui.

# ---------- Segredos da aplicação
# 32 bytes em base64:  openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# Assina os avisos de handoff enviados ao webhook da empresa (ex.: n8n)
HANDOFF_SIGNING_SECRET=

# ---------- LLM (anthropic | fake)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Preço usado no controle de custo (micro-dólares por milhão de tokens). Confira a tabela atual.
LLM_INPUT_MICROS_PER_MTOK=2000000
LLM_OUTPUT_MICROS_PER_MTOK=10000000
LLM_MAX_OUTPUT_TOKENS=800
LLM_TIMEOUT_MS=30000
AGENT_MAX_ITERATIONS=6
AGENT_RUN_TIMEOUT_MS=60000

# ---------- Áudio
# STT: openai | fake | disabled
STT_PROVIDER=openai
OPENAI_API_KEY=
STT_MODEL=gpt-4o-mini-transcribe
# TTS: elevenlabs | fake | disabled  (só responde em voz se a empresa habilitar)
TTS_PROVIDER=disabled
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ---------- Processamento
DEBOUNCE_MS=2500
LEASE_MS=90000
WORKER_CONCURRENCY=8
OUTBOX_RELAY_INTERVAL_MS=2000
ENQUEUE_TIMEOUT_MS=300
STORE_WEBHOOK_PAYLOADS=true
